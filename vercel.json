{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.anupambaral.com.np"
        }
      ],
      "destination": "https://anupambaral.com.np/:path*",
      "permanent": true
    },
    {
      "source": "/project/01",
      "destination": "/projects/e-learning-platform",
      "permanent": true
    },
    {
      "source": "/project/02",
      "destination": "/projects/yatra-solana-ride-sharing",
      "permanent": true
    },
    {
      "source": "/project/03",
      "destination": "/projects/web3-loyalty-protocol",
      "permanent": true
    },
    {
      "source": "/project/04",
      "destination": "/projects/greenstar-suppliers",
      "permanent": true
    },
    {
      "source": "/project/05",
      "destination": "/projects/yarshabyte-it-company",
      "permanent": true
    },
    {
      "source": "/projects/yarshabyte-agency",
      "destination": "/projects/yarshabyte-it-company",
      "permanent": true
    },
    {
      "source": "/project/:path*",
      "destination": "/projects/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://medium.com https://api.allorigins.win https://corsproxy.io https://api.rss2json.com https://api.web3forms.com https://www.google-analytics.com https://www.clarity.ms;"
        }
      ]
    }
  ]
}
